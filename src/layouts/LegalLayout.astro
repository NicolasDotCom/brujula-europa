---
// Layout de lectura para las páginas legales: índice lateral fijo y medida de línea cómoda.
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { site } from '../config/site';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  intro?: string;
  /** Secciones para el índice («En esta página»). */
  sections?: { id: string; title: string }[];
}
const { title, description, heading, intro, sections = [] } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Navbar onHome={false} />
  <main id="contenido" class="pb-24 pt-12 sm:pt-16">
    <div class="wrap">
      <header class="max-w-3xl">
        <nav aria-label="Ruta de navegación" class="small text-ink-2">
          <a class="link" href="/">Inicio</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span aria-current="page">{heading}</span>
        </nav>
        <h1 class="display-2 mt-6">{heading}</h1>
        {intro && <p class="lead mt-5">{intro}</p>}
        <p class="small mt-5 text-ink-2">Última actualización: {site.legal.lastUpdated}</p>
      </header>

      <div class="mt-12 grid grid-cols-1 gap-10 border-t border-line pt-12 lg:grid-cols-12 lg:gap-x-10">
        {
          sections.length > 0 && (
            <aside class="min-w-0 lg:col-span-3">
              <nav class="toc lg:sticky lg:top-28" aria-labelledby="toc-title">
                <h2 id="toc-title" class="font-sans text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-ink-2">
                  En esta página
                </h2>
                <ol class="mt-3" role="list">
                  {sections.map((s) => (
                    <li>
                      <a href={`#${s.id}`}>{s.title}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>
          )
        }
        <article class:list={['legal-prose min-w-0', sections.length > 0 ? 'lg:col-span-8 lg:col-start-5' : 'lg:col-span-9']}>
          <slot />
        </article>
      </div>
    </div>
  </main>
  <Footer onHome={false} />
</BaseLayout>
