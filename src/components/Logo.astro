---
// Logotipo de Victoria Tours: laurel en «V» con estrella (victoria y rumbo) + nombre en versales.
// El símbolo es un <symbol> del sprite de BaseLayout (#i-logo). Versiones sueltas en /brand.
import { site } from '../config/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const tag = ['T', 'O', 'U', 'R', 'S'];
---

<span class:list={['logo', className]}>
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><use href="#i-logo" /></svg>
  <span class="logo-word" aria-hidden="true">
    <span class="logo-name">Victoria</span>
    <span class="logo-tag">{tag.map((letter) => <span>{letter}</span>)}</span>
  </span>
  <span class="sr-only">{site.name}</span>
</span>
