---
// Logotipo: rosa de los vientos minimalista (norte macizo, sur en línea) + wordmark serif.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5 text-ink', className]}>
  <svg class="size-7 flex-none text-navy" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <circle cx="16" cy="16" r="14.75" fill="none" stroke="currentColor" stroke-width="1.25"></circle>
    <path d="M16 4.5 19.25 16h-6.5z" fill="currentColor"></path>
    <path d="M12.75 16h6.5L16 27.5z" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"></path>
    <path d="M3.5 16h3M25.5 16h3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
  </svg>
  <span class="font-serif text-[1.375rem] leading-none tracking-[-0.015em] whitespace-nowrap">
    Brújula <em class="italic">Europa</em>
  </span>
</span>
