---
// Hero editorial: titular serif + CTA a WhatsApp a la izquierda, fotografía vertical a la derecha.
// Dirección de arte: recorte cuadrado ligero en móvil/tablet y vertical en escritorio (donde es el LCP).
// AVIF con respaldo WebP, fetchpriority="high" + loading="eager".
import { getImage } from 'astro:assets';
import heroImg from '../assets/photos/glacier-express-landwasser.jpg';
import { getWhatsAppUrl, whatsappMessages } from '../config/site';
import Icon from './Icon.astro';

const whatsappHref = getWhatsAppUrl(whatsappMessages.hero);

const badges = [
  { icon: 'chat', text: 'Atención humana inmediata en WhatsApp' },
  { icon: 'lock', text: 'Pagos protegidos en € vía Stripe' },
  { icon: 'split', text: 'Financiación flexible con Klarna' },
] as const;

type Format = 'avif' | 'webp';
// Recorte centrado: en ambos encuadres el tren queda en el tercio superior.

/** Recorte cuadrado (móvil y tablet). */
async function squareSet(format: Format) {
  const widths = [480, 640, 800, 1080];
  const images = await Promise.all(
    widths.map((w) => getImage({ src: heroImg, width: w, height: w, fit: 'cover', format, quality: 42 })),
  );
  return images.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
}

/** Encuadre vertical 4:5 (escritorio). */
async function portraitSet(format: Format) {
  const widths = [640, 960, 1280];
  const images = await Promise.all(
    widths.map((w) =>
      getImage({ src: heroImg, width: w, height: Math.round(w * 1.25), fit: 'cover', format, quality: 50 }),
    ),
  );
  return images.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
}

const [portraitAvif, portraitWebp, squareAvif, squareWebp] = await Promise.all([
  portraitSet('avif'),
  portraitSet('webp'),
  squareSet('avif'),
  squareSet('webp'),
]);
const fallback = await getImage({ src: heroImg, width: 960, height: 960, fit: 'cover', format: 'webp', quality: 55 });
const desktopSizes = '(min-width: 86rem) 38rem, 46vw';
---

<section class="pb-16 pt-8 sm:pt-12 lg:pb-24" aria-labelledby="hero-title">
  <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-end lg:gap-x-10">
    <div class="lg:col-span-6 lg:pb-10">
      <p class="eyebrow">Viajes a medida y alquiler de vehículos</p>
      <h1 id="hero-title" class="display-1 mt-6">
        Viajes <em>a tu medida</em>, con un experto a un mensaje de distancia
      </h1>
      <p class="lead mt-6 max-w-[34rem]">
        Rutas por Europa, Australia y Asia, viajes a Europa desde Latinoamérica con el vuelo incluido
        y coches, campers o barcos de alquiler. Un asesor real te atiende por WhatsApp y pagas en
        euros con un enlace seguro de Stripe.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        <a class="btn btn-primary btn-lg" href={whatsappHref} target="_blank" rel="noopener" data-cta="hero">
          <Icon name="whatsapp" size={20} />
          Hablar con un asesor
          <span class="sr-only">(abre WhatsApp)</span>
        </a>
        <a class="btn btn-ghost btn-lg" href="#destinos">
          Explorar destinos
          <Icon name="arrow" size={18} class="arrow" />
        </a>
      </div>

      <ul class="mt-12 grid grid-cols-1 gap-4 border-t border-line pt-6 sm:grid-cols-3 sm:gap-6" role="list" aria-label="Garantías">
        {badges.map((badge) => (
          <li class="flex items-start gap-3 sm:flex-col sm:gap-2.5">
            <Icon name={badge.icon} size={22} class="mt-0.5 flex-none text-navy sm:mt-0" />
            <span class="small text-ink">{badge.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <figure class="lg:col-span-6">
      <div class="hero-media">
        <picture>
          <source media="(min-width: 64rem)" type="image/avif" srcset={portraitAvif} sizes={desktopSizes} />
          <source media="(min-width: 64rem)" type="image/webp" srcset={portraitWebp} sizes={desktopSizes} />
          <source type="image/avif" srcset={squareAvif} sizes="100vw" />
          <source type="image/webp" srcset={squareWebp} sizes="100vw" />
          <img
            src={fallback.src}
            width="960"
            height="960"
            alt="El tren panorámico Glacier Express cruza el viaducto de piedra de Landwasser entre montañas nevadas, en Suiza"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <figcaption class="caption mt-3 flex items-baseline justify-between gap-4">
        <span>Glacier Express sobre el viaducto de Landwasser</span>
        <span class="whitespace-nowrap">Grisones, Suiza</span>
      </figcaption>
    </figure>
  </div>
</section>
