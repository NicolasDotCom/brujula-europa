---
// Conversación ilustrativa (HTML/CSS puro) que enseña el flujo real: mensaje prellenado →
// confirmación del asesor → enlace de pago de Stripe. Ejemplo, no captura de una app.
import { experiences, experienceMessage, formatPrice } from '../config/site';
import Icon from './Icon.astro';

const sample = experiences.find((e) => e.id === 'toscana') ?? experiences[0]!;
const total = sample.priceFrom * 2;
---

<figure class="mx-auto w-full max-w-[26rem]">
  <div class="chat" aria-hidden="true">
    <div class="flex items-center gap-3 border-b border-line bg-paper-2 px-5 py-4">
      <span class="grid size-10 flex-none place-items-center rounded-full bg-navy text-paper">
        <svg class="size-6" viewBox="0 0 32 32" focusable="false">
          <path d="M16 6 18.75 16h-5.5z" fill="currentColor"></path>
          <path d="M13.25 16h5.5L16 26z" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="flex flex-col leading-tight">
        <span class="text-[0.9375rem] font-semibold">Lucía · Brújula Europa</span>
        <span class="text-[0.75rem] text-ink-2">Tu asesora de viaje · en línea</span>
      </span>
    </div>

    <div class="flex flex-col gap-2.5 px-4 py-5">
      <p class="bubble bubble-out">{experienceMessage(sample.title, sample.priceFrom)}<time>10:02</time></p>
      <p class="bubble bubble-in">
        ¡Hola! Soy Lucía. Para dos personas del 12 al 19 de mayo tengo disponible un agriturismo en
        Pienza con cena incluida. Precio final: {formatPrice(total)} los dos.<time>10:05</time>
      </p>
      <p class="bubble bubble-out">¡Perfecto! ¿Cómo lo reservamos?<time>10:06</time></p>

      <div class="bubble bubble-in w-[84%] pb-6!">
        <div class="overflow-hidden rounded-lg border border-line bg-paper-3">
          <div class="flex items-center justify-between border-b border-line px-3.5 py-2.5">
            <span class="flex items-center gap-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-navy">
              <Icon name="lock" size={13} />
              Pago seguro
            </span>
            <span class="text-[0.6875rem] text-ink-2">buy.stripe.com</span>
          </div>
          <div class="px-3.5 py-3.5">
            <span class="block text-[0.8125rem] text-ink-2">Toscana lenta · 2 personas</span>
            <span class="mt-0.5 block font-serif text-[1.75rem] leading-tight tracking-[-0.02em]">
              {formatPrice(total)}
            </span>
            <span class="mt-3 flex h-9 items-center justify-center rounded-full bg-navy text-[0.8125rem] font-semibold text-paper">
              Pagar ahora
            </span>
            <span class="mt-2.5 block text-center text-[0.6875rem] text-ink-2">
              Tarjeta · Apple Pay · Google Pay · Klarna
            </span>
          </div>
        </div>
        <time>10:07</time>
      </div>

      <p class="bubble bubble-out">Pagado ✓ ¡Gracias, Lucía!<time>10:09</time></p>
    </div>
  </div>
  <figcaption class="caption mt-4 text-center">
    Ejemplo ilustrativo de una reserva por WhatsApp<span class="sr-only">
      : pides disponibilidad con el mensaje ya escrito, tu asesora confirma el precio final y te envía
      un enlace de pago seguro de Stripe</span>.
  </figcaption>
</figure>
